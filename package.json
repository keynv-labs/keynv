{
  "name": "keynv",
  "version": "0.1.0-rc.21",
  "private": true,
  "description": "AI-safe secrets management. Aliases instead of values; AI agents never see real secrets.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "keynv exec -- pnpm -r build",
    "build:direct": "pnpm -r build",
    "dev": "keynv exec -- pnpm -r --parallel dev",
    "dev:direct": "pnpm -r --parallel dev",
    "test": "pnpm -r --filter '!@keynv/tests-e2e' test",
    "test:e2e": "pnpm --filter @keynv/tests-e2e test",
    "test:security": "pnpm --filter @keynv/tests-security test",
    "version:sync": "node scripts/sync-version.mjs",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=6144 biome check .",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=6144 biome check --write .",
    "format": "cross-env NODE_OPTIONS=--max-old-space-size=6144 biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true}); require('fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "argon2", "better-sqlite3", "esbuild"],
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.4.49",
      "qs": ">=6.15.2",
      "hono": ">=4.12.21",
      "form-data": ">=4.0.6",
      "vite": ">=8.0.16"
    },
    "auditConfig": {
      "//": "Escape hatch for `pnpm audit` (the release security-gate). Add a GHSA/CVE id here, with a comment + tracking issue, when an advisory has no available fix and no exploitable path in keynv — so a transitive upstream advisory cannot block all releases with zero code changes.",
      "ignoreCves": []
    }
  }
}
