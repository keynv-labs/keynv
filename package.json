{
  "name": "keynv",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "AI-safe secrets management. Aliases instead of values; AI agents never see real secrets.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:security": "pnpm -r test:security",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 biome check .",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=6144 biome check --write .",
    "format": "NODE_OPTIONS=--max-old-space-size=6144 biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "argon2",
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.25.0",
      "postcss": ">=8.4.49"
    }
  }
}
