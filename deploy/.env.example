# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
#
# keynv comes up with a SINGLE required setting: the first owner account.
# Everything else (JWT secret, master key, web session secret) is
# auto-generated on first boot and persisted on the Docker volumes.

# ─── Required: the first owner account ────────────────────────────────
#
# Created once, on first boot, when no org exists yet. After that these
# become no-ops — blank them out post-deploy to keep the password out of
# the running config. Password must be at least 12 characters.

KEYNV_BOOTSTRAP_OWNER_EMAIL=
KEYNV_BOOTSTRAP_OWNER_PASSWORD=
KEYNV_BOOTSTRAP_ORG_NAME=default

# ─── Optional ─────────────────────────────────────────────────────────

# Public HTTPS URL of the web dashboard (used for CORS/redirects).
# Example: https://keynv.example.com
KEYNV_WEB_URL=

# Public host ports (containers listen on 8080 / 3000 internally).
KEYNV_PORT=8080
KEYNV_WEB_PORT=3000

# pino log level: fatal | error | warn | info | debug | trace
KEYNV_LOG_LEVEL=info

# Per-user request budget per minute on authenticated routes (0 = off).
KEYNV_RATE_LIMIT_PER_MINUTE=120

# Open POST /v1/auth/register so anyone can self-register an org+owner.
# OFF by default; self-hosters invite users from /admin/users instead.
KEYNV_PUBLIC_REGISTRATION=false

# ─── Pin secrets explicitly (optional) ────────────────────────────────
#
# Leave blank to let keynv auto-generate + persist them. Set them only
# to pin a known value or to share one secret across replicas. Min 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
KEYNV_JWT_SECRET=
KEYNV_WEB_SESSION_SECRET=

# The web calls the server API server-side. On a single host the default
# in-network URL (http://keynv-server:8080) is correct; set this only if
# you split the web and server across hosts/domains.
KEYNV_SERVER_URL=

# ─── Litestream backup (optional — the `backup` compose profile) ──────
#
# Real-time SQLite WAL replication to S3/B2. OFF by default. Enable with:
#   docker compose -f deploy/docker-compose.yml --profile backup up -d
# after filling these in.

LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=keynv-backup
LITESTREAM_ENDPOINT=https://s3.us-east-1.amazonaws.com
LITESTREAM_REGION=us-east-1
