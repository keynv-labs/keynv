# Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# A 32+ char random string. Generate with: openssl rand -base64 32
KEYNV_JWT_SECRET=

# Public port the server listens on (host side). Container side is 8080.
KEYNV_PORT=8080

# pino log level. fatal | error | warn | info | debug | trace
KEYNV_LOG_LEVEL=info

# --- Litestream (SQLite real-time backup to S3/B2) ---
# Comment out the litestream service in docker-compose.yml if not used.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=keynv-backup
LITESTREAM_ENDPOINT=https://s3.us-east-1.amazonaws.com
LITESTREAM_REGION=us-east-1
