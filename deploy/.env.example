# Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# ─── Required ─────────────────────────────────────────────────────────

# 32+ char random string used to sign CLI access tokens.
# Generate with: openssl rand -base64 48
KEYNV_JWT_SECRET=

# ─── Auto-bootstrap (first-deploy only) ───────────────────────────────
#
# These trigger a one-time auto-bootstrap on first server start when
# /data/master.key is missing: master key generated, migrations run,
# org + owner row inserted. After the first successful start the
# master.key file exists and these vars become no-ops on every restart.
# Blank them out after the first deploy if you want to keep the
# password out of the deployment config.

KEYNV_BOOTSTRAP_OWNER_EMAIL=
KEYNV_BOOTSTRAP_OWNER_PASSWORD=
KEYNV_BOOTSTRAP_ORG_NAME=default

# ─── Optional ─────────────────────────────────────────────────────────

# Public HTTPS URL of the web dashboard (used for CORS, redirects).
# Example: https://keynv.example.com
KEYNV_WEB_URL=

# Public host port (the container always listens on 8080 internally).
KEYNV_PORT=8080

# pino log level. fatal | error | warn | info | debug | trace
KEYNV_LOG_LEVEL=info

# Per-user request budget per minute on authenticated routes. Default
# 120; set 0 to disable (not recommended in production).
KEYNV_RATE_LIMIT_PER_MINUTE=120

# ─── Public registration ─────────────────────────────────────────────
#
# Open POST /v1/auth/register so anyone on the public web can create
# their own org + owner. OFF by default. Set to true if this is the
# keynv Cloud-style instance (keynv.dev). Self-hosters who only want
# their own team accessing the vault should leave this blank/false and
# invite users via /admin/users instead.
#
# When enabled, every signup is throttled per-IP via
# KEYNV_REGISTER_RATE_LIMIT_PER_MINUTE (default 5).

KEYNV_PUBLIC_REGISTRATION=false
KEYNV_REGISTER_RATE_LIMIT_PER_MINUTE=5

# ─── Web dashboard (only when deploying deploy/coolify-web.yml) ──────
#
# The web app is a SEPARATE Coolify resource. Set these in that
# resource's env-var UI — they're listed here so you have one canonical
# reference of every env var keynv reads.

# Public HTTPS URL of the keynv-server resource. The web container
# fetches the API from this URL, just like the CLI does. Example:
#   https://api.keynv.dev
KEYNV_SERVER_URL=

# 32+ char random string. Encrypts the session cookie payload so the
# access token doesn't sit in plaintext on the user's disk.
# Generate: openssl rand -base64 48
KEYNV_WEB_SESSION_SECRET=

# ─── Litestream (optional — SQLite real-time backup to S3/B2) ────────
#
# Comment out the litestream service in docker-compose.yml if you
# don't want offsite backup yet. keynv works fine without it; you
# just lose the disaster-recovery story.

LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=keynv-backup
LITESTREAM_ENDPOINT=https://s3.us-east-1.amazonaws.com
LITESTREAM_REGION=us-east-1
