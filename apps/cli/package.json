{
  "name": "@keynv/cli",
  "version": "0.1.0-rc.21",
  "description": "Secrets vault CLI for teams and AI-assisted development — reference secrets by alias so the real values stay out of your code, shell history, and AI transcripts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keynv": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keynv-labs/keynv.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/keynv-labs/keynv#readme",
  "bugs": {
    "url": "https://github.com/keynv-labs/keynv/issues"
  },
  "keywords": ["secrets", "secrets-management", "vault", "ai-safety", "mcp", "cli", "keynv"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "build:bun": "bun build src/index.ts --compile --external ssh2 --external cpu-features --outfile dist/keynv",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@napi-rs/keyring": "^1.1.7",
    "chokidar": "^4",
    "libsodium-wrappers": "^0.7.16"
  },
  "optionalDependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@keynv/core": "workspace:*",
    "@keynv/rbac": "workspace:*",
    "@keynv/redactor": "workspace:*",
    "@keynv/testers": "workspace:*",
    "@keynv/text-surfaces": "workspace:*",
    "clipanion": "^4.0.0-rc.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typanion": "^3.14.0"
  }
}
