{
  "name": "@keynv/server",
  "version": "0.0.0",
  "private": true,
  "description": "keynv REST API server — Hono on Node, SQLite + Litestream backed.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@keynv/core": "workspace:*",
    "@keynv/rbac": "workspace:*"
  }
}
