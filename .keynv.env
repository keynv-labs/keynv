# keynv dogfooding — manage keynv's own secrets with keynv
#
# This file is checked into git. It contains alias references for
# secrets and plain defaults for non-secret config. Safe to commit.
#
# Prerequisites:
#   1. Install CLI:   npm install -g @keynv/cli
#   2. Login:         keynv login
#   3. Create vault entries:
#        keynv secret create @keynv.dev.jwt-secret
#        keynv secret create @keynv.dev.web-session-secret
#
# Then run:  keynv exec -- pnpm dev
#
# If you don't have a keynv server yet, skip this file and use
# dev:direct (sets KEYNV_JWT_SECRET inline):
#   pnpm dev:direct

# ─── Secrets (resolved from keynv vault) ───────────────────────
KEYNV_JWT_SECRET=@keynv.dev.jwt-secret
KEYNV_WEB_SESSION_SECRET=@keynv.dev.web-session-secret

# ─── Plain config (safe as-is) ─────────────────────────────────
KEYNV_SERVER_URL=http://localhost:8080
KEYNV_WEB_URL=http://localhost:3000
KEYNV_BOOTSTRAP_OWNER_EMAIL=dev@localhost
KEYNV_BOOTSTRAP_OWNER_PASSWORD=dev-password
KEYNV_BOOTSTRAP_ORG_NAME=keynv
KEYNV_PUBLIC_REGISTRATION=false
KEYNV_LOG_LEVEL=info
KEYNV_PORT=8080
