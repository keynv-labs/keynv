{
  "name": "@keynv/redactor",
  "version": "0.1.0-rc.21",
  "description": "keynv output and file redaction (regex + entropy + per-project custom patterns).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keynv-labs/keynv.git",
    "directory": "packages/redactor"
  },
  "homepage": "https://github.com/keynv-labs/keynv#readme",
  "bugs": { "url": "https://github.com/keynv-labs/keynv/issues" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
